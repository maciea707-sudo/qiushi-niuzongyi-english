12.0053,"y":73.2783,"w":12.0628,"h":1.7506}],"ipa":"/ˈseɪˌlzpɜːsən:/","meaning":"销售员:","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s029.wav"},{"id":"u17-p125-s019","speaker":"david","text":"I see.","rects":[{"x":25.0808,"y":77.79,"w":5.7645,"h":2.1354}],"ipa":"/ˌaɪ ˈsiː./","meaning":"原来如此","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s019.wav"},{"id":"u17-p125-s040","speaker":"david","text":"And the price fits my budget.","rects":[{"x":25.0808,"y":77.79,"w":34.3816,"h":4.1252}],"ipa":"/ˌænd ðə ˈpraɪs ˈfɪts maɪ ˈbʌdʒɪt./","meaning":"价格也符合我的预算","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s040.wav"},{"id":"u17-p125-s039","speaker":"david","text":"My mum loves blue.","rects":[{"x":30.462,"y":77.79,"w":20.6552,"h":2.1354}],"ipa":"/ˌmaɪ ˈmʌm ˈlʌvz ˈbluː./","meaning":"我妈妈喜欢蓝色。","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s039.wav"},{"id":"u17-p125-s030","speaker":"david","text":"David:","rects":[{"x":12.0053,"y":78.0094,"w":6.1717,"h":1.7506}],"ipa":"/ˈdeɪvɪd:/","meaning":"大卫:","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s030.wav"},{"id":"u17-p125-s041","speaker":"david","text":"I think it’s perfect!","rects":[{"x":25.0808,"y":79.7799,"w":31.1884,"h":4.1252}],"ipa":"/ˌaɪ ˈθɪŋk ɪts ˈpɜːfɪkt!/","meaning":"我认为这很完美！","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s041.wav"},{"id":"u17-p125-s042","speaker":"david","text":"I’ll take it.","rects":[{"x":32.8564,"y":81.7698,"w":10.704,"h":2.1354}],"ipa":"/ˌaɪl ˈteɪk ɪt./","meaning":"我将接受。","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s042.wav"},{"id":"u17-p125-s020","speaker":"salesperson","text":"Great!","rects":[{"x":25.0808,"y":84.511,"w":6.8606,"h":2.1354}],"ipa":"/ˈgreɪt!/","meaning":"太棒了！","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s020.wav"},{"id":"u17-p125-s043","speaker":"salesperson","text":"So that’s yuan.","rects":[{"x":31.5581,"y":84.511,"w":20.6799,"h":2.1354}],"ipa":"/ˌsəʊ ˈðæts jʊˈɑːn./","meaning":"这是人民币。","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s043.wav"},{"id":"u17-p125-s031","speaker":"salesperson","text":"Salesperson:","rects":[{"x":12.0053,"y":84.7303,"w":12.0628,"h":1.7506}],"ipa":"/ˈseɪˌlzpɜːsən:/","meaning":"销售员:","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s031.wav"},{"id":"u17-p125-s021","speaker":"david","text":"Here’s 30 yuan.","rects":[{"x":25.5687,"y":87.4511,"w":14.7482,"h":1.7375}],"ipa":"/ˈhɪəz ˈθɜːtiː jʊˈɑːn./","meaning":"这是30元人民币。","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s021.wav"},{"id":"u17-p125-s032","speaker":"david","text":"David:","rects":[{"x":12.0053,"y":87.4715,"w":6.1717,"h":1.7506}],"ipa":"/ˈdeɪvɪd:/","meaning":"大卫:","voice":"英式男声 · George","audio":"assets/audio/u17/u17-p125-s032.wav"},{"id":"u17-p125-s022","speaker":"salesperson","text":"Thank you.","rects":[{"x":25.0808,"y":89.9933,"w":11.9569,"h":2.1354}],"ipa":"/ˈθæŋk juː./","meaning":"谢谢。","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s022.wav"},{"id":"u17-p125-s044","speaker":"salesperson","text":"And here’s your change.","rects":[{"x":36.6544,"y":89.9933,"w":24.1828,"h":2.1354}],"ipa":"/ˌænd ˈhɪəz jɔː ˈtʃeɪndʒ./","meaning":"这是你的零钱。","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s044.wav"},{"id":"u17-p125-s033","speaker":"salesperson","text":"Salesperson:","rects":[{"x":12.0053,"y":90.2127,"w":12.0628,"h":1.7506}],"ipa":"/ˈseɪˌlzpɜːsən:/","meaning":"销售员:","voice":"英式男声 · Fable","audio":"assets/audio/u17/u17-p125-s033.wav"}]},{"page":126,"pdfPage":127,"width":532.9130249023438,"height":754.0159912109375,"image":"assets/pages/page-126.webp","sentences":[{"id":"u17-p126-s017","speaker":"narrator","text":"Unit 7","rects":[{"x":9.5745,"y":3.6233,"w":6.0077,"h":1.8477}],"ipa":"/ˈjuːnɪt ˈsevən/","meaning":"第7单元","voice":"英式女声 · Emma","audio":"assets/audio/u17/u17-p126-s017.wav"},{"id":"u17-p126-s018","speaker":"narrator","text":"C Plan your money","rects":[{"x":13.6011,"y":6.4851,"w":27.8265,"h":2.6041}],"ipa":"/