udio/u18/u18-p127-s003.wav"},{"id":"u18-p127-s028","speaker":"narrator","text":"all!","rects":[{"x":14.6281,"y":30.9691,"w":2.9414,"h":1.7375}],"ipa":"/ˈɔːl!/","meaning":"都给我滚开！","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s028.wav"},{"id":"u18-p127-s062","speaker":"narrator","text":"for the festival","rects":[{"x":72.2635,"y":33.2012,"w":14.5589,"h":2.0027}],"ipa":"/fɔː ðə ˈfestɪvəl/","meaning":"节日","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s062.wav"},{"id":"u18-p127-s029","speaker":"narrator","text":"My family","rects":[{"x":44.9876,"y":33.2013,"w":10.5503,"h":2.0027}],"ipa":"/ˌmaɪ ˈfæmɪliː/","meaning":"我的家人们","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s029.wav"},{"id":"u18-p127-s004","speaker":"narrator","text":"The Spring Festival is in winter.","rects":[{"x":14.6281,"y":33.3339,"w":30.1049,"h":1.7375}],"ipa":"/ðə ˈsprɪŋ ˈfestɪvəl ɪz ɪn ˈwɪntə./","meaning":"春节在冬。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s004.wav"},{"id":"u18-p127-s031","speaker":"narrator","text":"We also paper-cuts on our windows.","rects":[{"x":37.0612,"y":35.2492,"w":51.4201,"h":1.812}],"ipa":"/ˌwiː ˈɔːlsəʊ ˈpeɪpəˌkʌts ˌɒn ˌaʊə ˈwɪndəʊz./","meaning":"我们还在窗户上剪纸","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s031.wav"},{"id":"u18-p127-s030","speaker":"narrator","text":"by cleaning our house.","rects":[{"x":14.6282,"y":35.3237,"w":21.8447,"h":1.7375}],"ipa":"/baɪ ˈkliːnɪŋ ˌaʊə ˈhaʊs./","meaning":"通过清理我们的房子。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s030.wav"},{"id":"u18-p127-s032","speaker":"narrator","text":"That’s a fun.","rects":[{"x":14.6289,"y":37.2386,"w":28.7055,"h":1.812}],"ipa":"/ˈðæts ə ˈfʌn./","meaning":"这很有趣。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s032.wav"},{"id":"u18-p127-s005","speaker":"narrator","text":"In spring, we have the Qingming Festival.","rects":[{"x":14.6286,"y":39.6773,"w":40.2257,"h":1.7375}],"ipa":"/ɪn ˈsprɪŋ, wiː hæv ðə ˈfestɪvəl./","meaning":"春有清明节。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s005.wav"},{"id":"u18-p127-s033","speaker":"narrator","text":"My parents bring flowers to the","rects":[{"x":55.4467,"y":39.6773,"w":30.2973,"h":1.7375}],"ipa":"/ˌmaɪ ˈpeərənts ˈbrɪŋ ˈflaʊəz tə ðə/","meaning":"我父母带花来","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s033.wav"},{"id":"u18-p127-s034","speaker":"narrator","text":"resting places of dead relatives to show.","rects":[{"x":14.6286,"y":41.5932,"w":54.7609,"h":1.8115}],"ipa":"/ˈrestɪŋ ˈpleɪsɪz ɒv ˈded ˈrelətɪvz tə ˈʃəʊ./","meaning":"在死去的亲戚那里休息，以便显示。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s034.wav"},{"id":"u18-p127-s006","speaker":"narrator","text":"Then, in summer, we celebrate the Dragon Boat Festival.","rects":[{"x":14.6282,"y":44.032,"w":54.2122,"h":1.7375}],"ipa":"/ˈðen, ɪn ˈsʌmə, wiː ˈselɪbreɪt ðə ˈdrægən ˈbəʊt ˈfestɪvəl./","meaning":"然后，在夏天，我们庆祝龙舟节。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s006.wav"},{"id":"u18-p127-s007","speaker":"narrator","text":"I like to eat rice dumplings.","rects":[{"x":69.4329,"y":44.032,"w":14.8081,"h":1.7375},{"x":14.6282,"y":46.0218,"w":10.8924,"h":1.7375}],"ipa":"/ˌaɪ ˈlaɪk tʊ ˈiːt ˈraɪs ˈdʌmplɪŋz./","meaning":"我喜欢吃米饺子","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s007.wav"},{"id":"u18-p127-s035","speaker":"narrator","text":"In some places, there are exciting dragon boat.","rects":[{"x":26.113,"y":45.9478,"w":61.6324,"h":1.8115}],"ipa":"/ɪn ˌsʌm ˈpleɪsɪz, ðeə ɑː ɪˈksaɪtɪŋ ˈdrægən ˈbəʊt./","meaning":"在一些地方，有令人兴奋的龙船。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s035.wav"},{"id":"u18-p127-s008","speaker":"narrator","text":"The Mid-Autumn Festival is also important.","rects":[{"x":14.6279,"y":48.3866,"w":41.9761,"h":1.7375}],"ipa":"/ðə ˌmɪˈdɔːtəm ˈfestɪvəl ɪz ˈɔːlsəʊ ɪˈmpɔːtənt./","meaning":"中秋节也很重要。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s008.wav"},{"id":"u18-p127-s009","speaker":"narrator","text":"In my family, we always eat mooncakes together.","rects":[{"x":57.1964,"y":48.3866,"w":26.5963,"h":1.7375},{"x":14.6279,"y":50.3765,"w":19.8918,"h":1.7375}],"ipa":"/ɪn maɪ ˈfæmɪliː, wiː ˈɔːlweɪz ˈiːt təˈgeðə./","meaning":"在我家，我们总是一起吃月饼。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s009.wav"},{"id":"u18-p127-s036","speaker":"narrator","text":"Mooncakes are a of family reunion.","rects":[{"x":35.1121,"y":50.3025,"w":50.8627,"h":1.8115}],"ipa":"/ɑː ə ɒv ˈfæmɪliː riːˈjuːnɪən./","meaning":"月饼是一家人团聚的","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s036.wav"},{"id":"u18-p127-s037","speaker":"narrator","text":"We eat them staying together forever.","rects":[{"x":14.6283,"y":52.2918,"w":52.871,"h":1.812}],"ipa":"/ˌwiː ˈiːt ˌðem ˈsteɪɪŋ təˈgeðə fəˈrevə./","meaning":"我们永远一起吃它们","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s037.wav"},{"id":"u18-p127-s011","speaker":"narrator","text":"Complete their conversation with the correct forms of the verbs in brackets.","rects":[{"x":81.9714,"y":57.5751,"w":8.375,"h":2.0721},{"x":12.0052,"y":59.5644,"w":56.9357,"h":2.0721}],"ipa":"/kəˈmpliːt ðeə ˌkɒnvəˈseɪʃən wɪð ðə kəˈrekt ˈfɔːmz ɒv ðə ˈvɜːbz ɪn ˈbrækɪts./","meaning":"用括号中动词的正确形式完成对话。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s011.wav"},{"id":"u18-p127-s010","speaker":"narrator","text":"A2 David is having a video call with his British friend, Emily, on New Year’s Eve.","rects":[{"x":12.5853,"y":57.5751,"w":68.9313,"h":2.0721}],"ipa":"/ˈeɪ ˈtuː ˈdeɪvɪd ɪz ˈhævɪŋ ə ˈvɪdɪəʊ ˈkɔːl wɪð hɪz ˈbrɪtɪʃ ˈfrend,, ˌɒn ˈnjuː ˈjɪəz ˈiːv./","meaning":"A2 David在除夕与英国朋友Emily有视频通话。","voice":"英式女声 · Emma","audio":"assets/audio/u18/u18-p127-s010.wav"},{"id":"u18-p127-s012","speaker":"emily","text":"Hi David.","rects":[{"x":19.2311,"y":62.6276,"w":10.1549,"h":2.1354}],"ipa":"/ˈhaɪ ˈdeɪvɪd./","meaning":"嗨，大卫。","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s012.wav"},{"id":"u18-p127-s066","speaker":"emily","text":"Are you getting ready for New Year’s Eve celebrations?","rects":[{"x":29.0027,"y":62.6276,"w":52.8308,"h":2.1354}],"ipa":"/ˌɑː juː ˈgetɪŋ ˈrediː fɔː ˈnjuː ˈjɪəz ˈiːv ˌselɪˈbreɪʃənz?/","meaning":"你准备好庆祝除夕节了吗？","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s066.wav"},{"id":"u18-p127-s038","speaker":"emily","text":"Emily:","rects":[{"x":12.0053,"y":62.8469,"w":5.7816,"h":1.7506}],"ipa":"/ˈeməliː/","meaning":"艾米丽：","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s038.wav"},{"id":"u18-p127-s067","speaker":"david","text":"Yes!","rects":[{"x":19.2311,"y":64.9924,"w":4.5942,"h":2.1354}],"ipa":"/ˈjes!/","meaning":"对！","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s067.wav"},{"id":"u18-p127-s039","speaker":"david","text":"David:","rects":[{"x":11.5175,"y":65.0128,"w":7.1475,"h":2.1485}],"ipa":"/ˈdeɪvɪd:/","meaning":"大卫:","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s039.wav"},{"id":"u18-p127-s042","speaker":"david","text":"Right now, I","rects":[{"x":39.1101,"y":65.0587,"w":12.4142,"h":2.0027}],"ipa":"/ˈraɪt ˈnaʊ, ˌaɪ/","meaning":"现在我","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s042.wav"},{"id":"u18-p127-s063","speaker":"david","text":"(spend) time with my","rects":[{"x":68.2492,"y":65.0591,"w":21.5067,"h":2.0027}],"ipa":"/(ˈspend) ˈtaɪm wɪð ˈmaɪ/","meaning":"(花时间) 与我","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s063.wav"},{"id":"u18-p127-s040","speaker":"david","text":"It’s 6 p.m.","rects":[{"x":23.9298,"y":65.1913,"w":9.5445,"h":1.7375}],"ipa":"/ˌɪts ˈsɪks ˌpiːˈem/","meaning":"这是下午6点。","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s040.wav"},{"id":"u18-p127-s041","speaker":"david","text":"here.","rects":[{"x":34.0667,"y":65.1913,"w":4.7888,"h":1.7375}],"ipa":"/ˈhɪə./","meaning":"在这里。","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s041.wav"},{"id":"u18-p127-s043","speaker":"david","text":"family.","rects":[{"x":19.7188,"y":67.1816,"w":6.5866,"h":1.7375}],"ipa":"/ˈfæmɪliː./","meaning":"家庭 家庭 家庭","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s043.wav"},{"id":"u18-p127-s044","speaker":"david","text":"We’re all at home together.","rects":[{"x":26.8978,"y":67.1816,"w":25.9973,"h":1.7375}],"ipa":"/ˌwɪə ˈɔːl æt ˈhəʊm təˈgeðə./","meaning":"我们一起在家。","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s044.wav"},{"id":"u18-p127-s013","speaker":"emily","text":"What are your family doing?","rects":[{"x":19.7188,"y":69.5465,"w":27.6923,"h":1.7375}],"ipa":"/ˌwɒt ɑː jɔː ˈfæmɪliː ˈduːɪŋ?/","meaning":"你的家人在干吗？","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s013.wav"},{"id":"u18-p127-s045","speaker":"emily","text":"Emily:","rects":[{"x":12.0051,"y":69.5669,"w":5.7816,"h":1.7506}],"ipa":"/ˈeməliː/","meaning":"艾米丽：","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s045.wav"},{"id":"u18-p127-s068","speaker":"david","text":"My grandparents (watch) fireworks celebrations on TV.","rects":[{"x":19.2309,"y":71.7123,"w":70.4296,"h":2.1358}],"ipa":"/ˌmaɪ ˈgræˌndpeərənts (ˈwɒtʃ) ˈfaɪəwɜːks ˌselɪˈbreɪʃənz ˌɒn ˌtiːˈviː./","meaning":"我爷爷奶奶(看)在电视上庆祝烟花","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s068.wav"},{"id":"u18-p127-s046","speaker":"david","text":"David:","rects":[{"x":11.5172,"y":71.7327,"w":7.1475,"h":2.1485}],"ipa":"/ˈdeɪvɪd:/","meaning":"大卫:","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s046.wav"},{"id":"u18-p127-s047","speaker":"david","text":"My parents (make) dinner.","rects":[{"x":19.719,"y":73.8271,"w":42.2773,"h":1.812}],"ipa":"/ˌmaɪ ˈpeərənts (ˌmeɪk) ˈdɪnə./","meaning":"我的父母(做)晚饭。","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s047.wav"},{"id":"u18-p127-s048","speaker":"david","text":"What are you doing in the","rects":[{"x":62.5888,"y":73.901,"w":25.5291,"h":1.7375}],"ipa":"/ˌwɒt ɑː juː ˈduːɪŋ ɪn ðə/","meaning":"你在这干嘛？","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s048.wav"},{"id":"u18-p127-s049","speaker":"david","text":"UK?","rects":[{"x":19.7191,"y":75.8909,"w":3.9425,"h":1.7375}],"ipa":"/ˌjuːˈkeɪ?/","meaning":"英国？","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s049.wav"},{"id":"u18-p127-s069","speaker":"emily","text":"It’s only a.m.","rects":[{"x":19.2312,"y":78.0568,"w":16.4629,"h":2.1354}],"ipa":"/ˌɪts ˈəʊnliː ˌeɪˈem/","meaning":"只是凌晨而已。","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s069.wav"},{"id":"u18-p127-s050","speaker":"emily","text":"Emily:","rects":[{"x":11.5176,"y":78.0772,"w":6.7574,"h":2.1485}],"ipa":"/ˈeməliː/","meaning":"艾米丽：","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s050.wav"},{"id":"u18-p127-s064","speaker":"emily","text":"(clean) the house for","rects":[{"x":67.1367,"y":78.123,"w":20.5572,"h":2.0027}],"ipa":"/(ˈkliːn) ðə ˈhaʊs fɔː/","meaning":"(清洁) 房子为","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s064.wav"},{"id":"u18-p127-s052","speaker":"emily","text":"My mum","rects":[{"x":40.8421,"y":78.1231,"w":9.5699,"h":2.0027}],"ipa":"/ˌmaɪ ˈmʌm/","meaning":"我妈妈","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s052.wav"},{"id":"u18-p127-s051","speaker":"emily","text":"here.","rects":[{"x":35.7987,"y":78.2557,"w":4.7888,"h":1.7375}],"ipa":"/ˈhɪə./","meaning":"在这里。","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s051.wav"},{"id":"u18-p127-s054","speaker":"emily","text":"I (help) her.","rects":[{"x":37.59,"y":80.1711,"w":28.0535,"h":1.812}],"ipa":"/ˌaɪ (ˈhelp) ˌhɜː./","meaning":"我 (帮助)她。","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s054.wav"},{"id":"u18-p127-s053","speaker":"emily","text":"our party tonight.","rects":[{"x":19.7188,"y":80.2455,"w":17.2788,"h":1.7375}],"ipa":"/ˌaʊə ˈpɑːtiː təˈnaɪt./","meaning":"我们今晚的派对。","voice":"英式女声 · Alice","audio":"assets/audio/u18/u18-p127-s053.wav"},{"id":"u18-p127-s014","speaker":"david","text":"Where is your dad?","rects":[{"x":19.7189,"y":82.6098,"w":18.5586,"h":1.7375}],"ipa":"/ˌweə ɪz jɔː ˈdæd?/","meaning":"你爸爸呢？ 你父亲呢？","voice":"英式男声 · George","audio":"assets/audio/u18/u18-p127-s014.wav"},{"id":"u18-p127-s055","speaker":"david","text":"David:","rec